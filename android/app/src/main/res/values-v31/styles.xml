<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ siempre muestra su propia pantalla de arranque (ícono
         centrado sobre un color) y recorta el ícono a un círculo de 192 dp,
         donde el logo completo, ahora más grande, no entra. Por eso muestra
         solo el fondo blanco, con un ícono vacío, y el logo aparece una sola
         vez en SplashPage, sobre el mismo fondo: no hay dos logos ni saltos.-->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
