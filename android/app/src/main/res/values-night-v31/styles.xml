<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PRUEBA Android 12+: la pantalla del sistema muestra el logo completo de
         una vez, a 36 dp de alto (lo más grande que entra en el círculo de
         192 dp que Android deja ver). Al pasar a Flutter, MainActivity lo
         agranda en 0,2 s hasta los 46 dp de SplashPage, y recién entonces
         quita la pantalla del sistema: debajo está el mismo logo, igual.-->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
